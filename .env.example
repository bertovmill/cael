# Copy to .env.local and fill in. Only the "Required" block is needed to boot;
# everything else turns a feature on and the app runs without it.

# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string. Any Postgres works; Neon's free tier is the
# easiest. Tables create themselves on first boot (lib/db.ts ensureSchema).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# The one email address that gets the full private app. Everyone else who signs
# in sees the not-authorized page.
OWNER_EMAIL=you@example.com

# The app's public origin, used for absolute links (media, push, MCP hint).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Password login at /login-password. Works without Clerk, so it's the quickest
# way in for local dev.
BASIC_AUTH_PASSWORD=change-me

# The agent's model calls go through Vercel AI Gateway. On Vercel this is
# automatic (OIDC). Locally, either run `vercel env pull` after linking a
# project, or set a gateway key:
AI_GATEWAY_API_KEY=

# ── Sign-in (optional, recommended for production) ──────────────────────────
# Clerk. Without these the app falls back to the password login above.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Google: Calendar and watch data (optional) ──────────────────────────────
# One OAuth client in Google Cloud. Enable the Calendar API (and the Google
# Health API for steps/sleep), add http(s)://<your-host>/api/google/callback
# as a redirect URI, then connect once from /api/google/connect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Your timezone. Days, streaks and the calendar are bucketed in it.
GOOGLE_CALENDAR_TIMEZONE=America/New_York

# ── Scheduled jobs and integrations (optional) ──────────────────────────────
# Protects /api/cron/*. Vercel Cron sends it automatically.
CRON_SECRET=
# Bearer token for the MCP server at /api/mcp (lets Claude Code etc. use Cael).
MCP_TOKEN=
# File uploads (images, sketches). Vercel Blob; set automatically when a Blob
# store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# ── Push notifications (optional) ───────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Voice (optional) ────────────────────────────────────────────────────────
# Without either, the chat speaks with the device's built-in voice.
ELEVEN_LABS_API_KEY=
DEEPINFRA_API_KEY=

# ── Chat channels (optional) ────────────────────────────────────────────────
# Each channel answers only the owner. Leave the owner id empty and the channel
# ignores everyone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_BOT_USERNAME=
# Your numeric Telegram user id (ask @userinfobot).
TELEGRAM_OWNER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Comma-separated E.164 numbers allowed to text or call the agent.
TWILIO_ALLOW_FROM=
# Slack via Vercel Connect: the connector id and your Slack user id.
SLACK_CONNECTOR=
SLACK_OWNER_ID=

# ── Publishing (optional) ───────────────────────────────────────────────────
# Your own X handle, without the @. The X_* tokens below post as this account.
NEXT_PUBLIC_X_HANDLE=
# Set if published posts also appear on a site of yours (links point there).
PUBLIC_SITE_URL=
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LUMA_API_KEY=

# ── GitHub (optional) ───────────────────────────────────────────────────────
# Your fork, as owner/name. Feature requests become issues here, and the
# self-editing agent opens draft PRs against it.
CAEL_GITHUB_REPO=
# A fine-grained token scoped to your fork, for the agent's GitHub connection.
GITHUB_TOKEN=
# Same idea, used by eve's self-modification subagent (Contents + Pull requests).
EVE_SELF_MODIFICATION_GITHUB_TOKEN=
# Comma-separated GitHub usernames whose merged PRs count on the Home screen.
GITHUB_ACCOUNTS=
